# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vsync?retryWrites=true&w=majority

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
PORT=5000

# Only these email domains may self-register (leave empty to allow any, dev only)
ALLOWED_EMAIL_DOMAINS=vitstudent.ac.in,vit.ac.in

# Frontend URL(s) allowed by CORS, comma-separated (e.g. your Vercel URL). * = any
CLIENT_ORIGIN=http://localhost:5173

KARMA_STARTING_BALANCE=100
ENABLE_SCHEDULER=true

# Load demo accounts/data on boot when the database is empty (useful on hosts without a shell)
SEED_DEMO_DATA=false

# --- Google Sign-In (OpenID Connect) ---
# OAuth 2.0 Web client ID from Google Cloud Console. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
# Workspace domains allowed to sign in (checked against the token's `hd` claim)
GOOGLE_ALLOWED_DOMAINS=vitstudent.ac.in,vit.ac.in
# Domains that get a student account automatically on first sign-in (others must be created by Admin)
GOOGLE_STUDENT_DOMAINS=vitstudent.ac.in
# Email + password login for the demo role accounts. false = Google is the only way in.
ENABLE_PASSWORD_LOGIN=true
